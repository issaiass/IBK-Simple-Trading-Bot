IBKR_HOST=127.0.0.1
# API port. It must agree with PAPER_TRADING (a mismatch aborts the bot):
#   TWS paper 7497 | TWS live 7496 | IB Gateway paper 4002 | IB Gateway live 4001
# Stay on paper (7497 or 4002 with PAPER_TRADING=true) until the paper run is proven.
IBKR_PORT=7497
IBKR_CLIENT_ID=2
IBKR_EXEC_CLIENT_ID=3
PAPER_TRADING=true
PORTFOLIO_VALUE_USD=25000
MAX_TRADE_SIZE_USD=2500
MAX_TRADES_PER_DAY=5
MAX_RISK_PER_TRADE_PCT=1.0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_URL=
# Dashboard API (uv run serve-api); optional, defaults shown
# DASHBOARD_API_HOST=127.0.0.1
# DASHBOARD_API_PORT=8000
