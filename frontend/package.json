{
    "name": "frontend",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "e2e": "playwright test --project=desktop --project=phone",
        "e2e:ui": "playwright test --ui",
        "desktop:build": "node desktop/scripts/build-web.mjs",
        "desktop": "npm run desktop:build && electron .",
        "desktop:dev": "electron .",
        "desktop:dist": "npm run desktop:build && electron-builder --win portable",
        "e2e:desktop": "npm run desktop:build && playwright test --project=desktop-app"
    },
    "dependencies": {
        "@base-ui/react": "^1.8.0",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.4.0",
        "lucide-react": "^1.53.0",
        "next": "16.4.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "shadcn": "^4.21.4",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@playwright/test": "^1.64.0",
        "@tailwindcss/node": "^4.3.3",
        "@tailwindcss/postcss": "^4.3.3",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react": "^4.7.0",
        "electron": "^37.10.3",
        "electron-builder": "^25.1.8",
        "eslint": "^9",
        "eslint-config-next": "16.4.0",
        "jsdom": "^26.1.0",
        "tailwindcss": "^4",
        "typescript": "^5",
        "vitest": "^3.2.7"
    },
    "main": "desktop/main.mjs",
    "description": "Trading Bot dashboard",
    "author": "Trading Bot",
    "build": {
        "appId": "com.tradingbot.dashboard",
        "productName": "Trading Bot",
        "directories": {
            "output": "dist-desktop"
        },
        "files": [
            "desktop/**/*",
            "!desktop/**/*.test.mjs",
            "!desktop/scripts/**",
            "!desktop/assets/icon.svg",
            "out/**/*",
            "package.json",
            "!node_modules/**/*"
        ],
        "win": {
            "target": "portable",
            "signAndEditExecutable": false,
            "icon": "desktop/assets/icon.png"
        },
        "portable": {
            "artifactName": "TradingBot-${version}-portable.exe"
        }
    }
}
